{
  "name": "@bytepunx/authstar-lookout",
  "version": "0.1.0",
  "private": true,
  "description": "Lookout -- stateless analytics ingestion API for authstar (validate, then relay onto RabbitMQ)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:behavior && npm run test:e2e",
    "test:unit": "vitest run spec/unit",
    "test:behavior": "vitest run spec/behavior",
    "test:e2e": "vitest run spec/e2e",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run spec/integration",
    "test:all": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bytepunx/signet-client": "^0.7.0",
    "amqplib": "^0.10.8",
    "fastify": "^5.0.0",
    "node-flakes": "^2.1.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
