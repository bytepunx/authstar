{
  "name": "@bytepunx/authstar-tower",
  "version": "0.1.0",
  "private": true,
  "description": "Tower -- identity, roles, tenant, and application API for authstar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "pretest": "npm run build",
    "test": "npm run test:behavior && npm run test:e2e",
    "test:behavior": "vitest run spec/behavior",
    "test:e2e": "vitest run spec/e2e",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run spec/integration",
    "test:all": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bytepunx/authstar-fastify": "^2.0.1",
    "@bytepunx/signet-client": "^0.8.0",
    "@fastify/swagger": "^9.0.0",
    "amqplib": "^0.10.0",
    "consequent": "^2.0.8",
    "consequent-postgres": "^2.0.6",
    "fastify": "^5.0.0",
    "fount": "^1.1.5",
    "jose": "^5.9.0",
    "node-flakes": "^2.1.0",
    "pg": "^8.22.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.1": true,
    "farmhash@3.3.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
