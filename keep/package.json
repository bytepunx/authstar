{
  "name": "@bytepunx/authstar-keep",
  "version": "0.1.0",
  "private": true,
  "description": "Keep -- payments, billing, and Stripe integration API for authstar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "pretest": "npm run build",
    "test": "npm run test:behavior && npm run test:e2e",
    "test:behavior": "vitest run spec/behavior",
    "test:e2e": "vitest run spec/e2e",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run spec/integration",
    "test:live": "vitest run spec/live",
    "test:all": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "report:tenant-scope": "npm run build && node dist/report-tenant-scope.js"
  },
  "dependencies": {
    "@bytepunx/authstar-fastify": "^2.0.1",
    "@bytepunx/signet-client": "^0.9.0",
    "@fastify/swagger": "^9.0.0",
    "amqplib": "^0.10.0",
    "consequent": "^2.0.1",
    "consequent-postgres": "^2.0.4",
    "fastify": "^5.0.0",
    "fount": "^1.1.5",
    "jose": "^5.9.0",
    "node-flakes": "^2.1.0",
    "pino": "^9.0.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "farmhash@3.3.1": true,
    "farmhash@5.0.1": true,
    "cpu-features": false,
    "esbuild": false,
    "protobufjs": false,
    "ssh2": false
  }
}
