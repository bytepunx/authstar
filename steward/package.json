{
  "name": "@bytepunx/authstar-steward",
  "version": "0.1.0",
  "private": true,
  "description": "Steward -- operator console for authstar's own installation operators",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:behavior": "vitest run tests/behavior",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run test:behavior && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bytepunx/signet-client": "^0.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.8",
    "tslib": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "protobufjs": false,
    "esbuild": false
  }
}
