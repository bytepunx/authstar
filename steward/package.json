{
  "name": "@bytepunx/authstar-steward",
  "version": "0.1.0",
  "private": true,
  "description": "Steward -- operator console for authstar's own installation operators",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:behavior": "vitest run tests/behavior",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run test:behavior && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.12.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.7.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
