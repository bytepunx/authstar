# Server-side: base URL `web`'s own tower client calls (locals.clients.tower).
# Env-Only Mode only (ADR 0102/Story 012) -- ignored in Signet-Configured
# Mode (SIGNET_ADDR set), where this is sourced exclusively from the signet
# bundle instead. See hooks.server.ts / src/lib/server/config.ts.
TOWER_BASE_URL=http://tower.internal:3000

# Server-side: base URL `web`'s own keep client calls (locals.clients.keep).
# Same Env-Only-Mode-only scoping as TOWER_BASE_URL above.
KEEP_BASE_URL=http://keep.internal:3000

# Server-side: JWKS endpoint for verifying the portcullis-forwarded internal
# JWT (per-tenant ES256 keys). Same Env-Only-Mode-only scoping as
# TOWER_BASE_URL above. If unset (in Env-Only Mode), falls back to resolving
# each tenant's JWKS URL dynamically via tower's `GET /tenants/:slug`
# (ADR 0089/0091) -- see hooks.server.ts's own comment. Set this to point at
# a fixed JWKS endpoint instead (e.g. a fixture server for e2e/dev; see
# playwright.config.ts).
INTERNAL_JWT_JWKS_URL=

# Server-side, optional: signet workload gRPC address (e.g.
# "signet.internal:8443"). Unset by default -- Env-Only Mode, today's
# behavior above. If set, web dials signet at startup (SIGNET_NAMESPACE and
# SIGNET_TRUST_DOMAIN also become required) and sources TOWER_BASE_URL,
# KEEP_BASE_URL, and INTERNAL_JWT_JWKS_URL exclusively from the fetched
# bundle instead of the env vars above (ADR 0102/Story 012).
SIGNET_ADDR=
SIGNET_NAMESPACE=
SIGNET_TRUST_DOMAIN=

# Browser-visible: the ONE case (public signup page, Story 010) where `web`
# calls a backend service directly from the browser, no portcullis
# mediation. Must be a host tower's CORS config allows. Deliberately plain
# env, not signet-sourced, even in Signet-Configured Mode -- it's
# client-visible by design, outside the signet/secret boundary (ADR 0102).
PUBLIC_TOWER_BASE_URL=http://localhost:3000
